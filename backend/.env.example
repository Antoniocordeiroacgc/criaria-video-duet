ENV=production
MAX_UPLOAD_MB=300
MAX_VIDEO_DURATION_SECONDS=180

DATABASE_URL=postgresql+psycopg://criaria:criaria@db:5432/criaria_duet

# Storage local para DESENVOLVIMENTO (MinIO, já incluso no docker-compose).
# Quando for para produção, troque pelos dados reais do Cloudflare R2 (veja
# instruções no fim deste arquivo) e mude S3_FORCE_PATH_STYLE para false.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=criaria
S3_SECRET_ACCESS_KEY=criaria123
S3_BUCKET_NAME=criaria-video-duet
S3_REGION=auto
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- PRODUÇÃO: Cloudflare R2 (descomente e preencha quando for hospedar) ---
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<sua-access-key-r2>
# S3_SECRET_ACCESS_KEY=<sua-secret-key-r2>
# S3_FORCE_PATH_STYLE=false

WATERMARK_TEXT=CRIAR.IA TECNOLOGIA | criarhub.com

REDIS_URL=redis://redis:6379/0
JOB_RETENTION_HOURS=168
